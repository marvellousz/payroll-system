// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  staff
}

enum OvertimeUnit {
  hour
  day
  fixed
}

enum AttendanceStatus {
  present
  absent
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  outlets    Outlet[]
  profiles   Profile[]
  audit_logs AuditLog[]
}

// ─── Profile (linked to Supabase auth.users) ──────────────────────────────────

model Profile {
  id         String   @id // = Supabase auth.users.id (UUID)
  org_id     String
  email      String   @unique
  username   String   @unique
  role       UserRole @default(staff)
  created_at DateTime @default(now())

  org           Organization    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  salary_payments SalaryPayment[]
  audit_logs    AuditLog[]

  @@index([org_id])
  @@index([username])
}

// ─── Outlet ───────────────────────────────────────────────────────────────────

model Outlet {
  id             String       @id @default(uuid())
  org_id         String
  name           String
  overtime_rate  Decimal      @default(0) @db.Decimal(10, 2)
  overtime_unit  OvertimeUnit @default(hour)
  created_at     DateTime     @default(now())

  org       Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([org_id])
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id               String   @id @default(uuid())
  outlet_id        String
  name             String
  monthly_salary   Decimal  @db.Decimal(10, 2)
  paid_leave_days  Int      @default(0)
  created_at       DateTime @default(now())

  outlet            Outlet             @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
  attendance_records AttendanceRecord[]
  payroll_summaries  PayrollSummary[]
  salary_payments    SalaryPayment[]

  @@index([outlet_id])
}

// ─── AttendanceRecord ─────────────────────────────────────────────────────────

model AttendanceRecord {
  id             String           @id @default(uuid())
  employee_id    String
  date           DateTime         @db.Date
  status         AttendanceStatus
  overtime_units Decimal?         @db.Decimal(8, 2)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, date])
  @@index([employee_id])
}

// ─── PayrollSummary ───────────────────────────────────────────────────────────

model PayrollSummary {
  id                     String   @id @default(uuid())
  employee_id            String
  month                  Int      // 1–12
  year                   Int
  days_present           Int
  days_absent            Int
  paid_leave_days        Int
  base_pay               Decimal  @db.Decimal(10, 2)
  overtime_total_units   Decimal  @db.Decimal(8, 2)
  overtime_rate_snapshot Decimal  @db.Decimal(10, 2)
  overtime_pay           Decimal  @db.Decimal(10, 2)
  total_pay              Decimal  @db.Decimal(10, 2)
  salary_given           Decimal  @db.Decimal(10, 2) @default(0)
  previous_balance       Decimal  @db.Decimal(10, 2) @default(0)
  monthly_balance        Decimal  @db.Decimal(10, 2) @default(0)
  closing_balance        Decimal  @db.Decimal(10, 2) @default(0)
  generated_at           DateTime @default(now())
  updated_at             DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, month, year])
  @@index([employee_id])
}

// ─── SalaryPayment ────────────────────────────────────────────────────────────

model SalaryPayment {
  id          String   @id @default(uuid())
  employee_id String
  month       Int
  year        Int
  amount      Decimal  @db.Decimal(10, 2)
  paid_at     DateTime @default(now())
  created_by  String   // Profile.id
  created_at  DateTime @default(now())

  employee   Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  created_by_profile Profile @relation(fields: [created_by], references: [id])

  @@index([employee_id, month, year])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  org_id        String
  user_id       String
  entity_type   String   // e.g. "Employee", "AttendanceRecord", "Outlet"
  entity_id     String
  field_changed String?
  old_value     String?
  new_value     String?
  timestamp     DateTime @default(now())

  org  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user Profile      @relation(fields: [user_id], references: [id])

  @@index([org_id, timestamp])
  @@index([entity_type, entity_id])
  @@index([user_id])
}
